# Copie para .env.local só se for rodar no seu computador.
# Na Vercel, cadastre estas variáveis em Settings → Environment Variables.

# Endereço do Postgres (a integração Neon da Vercel preenche sozinha)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Senha que você usa para entrar no painel do consultor
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Texto aleatório e longo usado para assinar o login (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-por-um-texto-aleatorio-longo
